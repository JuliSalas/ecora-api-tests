{
  "name": "ecora-api-tests",
  "version": "1.0.0",
  "description": "Pruebas funcionales automatizadas de la API de Ecora (Jest + Axios)",
  "scripts": {
    "test": "jest --runInBand",
    "test:ordenes": "jest --runInBand tests/ordenes.test.js",
    "test:extras": "jest --runInBand tests/ordenes.extras.test.js",
    "test:usuarios": "jest --runInBand tests/usuarios.test.js",
    "test:productos": "jest --runInBand tests/productos.test.js",
    "test:categorias": "jest --runInBand tests/categorias.test.js",
    "test:prod-cat": "jest --runInBand tests/productos.test.js tests/categorias.test.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000
  },
  "dependencies": {
    "axios": "^1.7.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}